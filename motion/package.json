{
  "name": "fairshare-motion",
  "version": "1.0.0",
  "description": "Fairshare research workflow animation",
  "repository": {
    "type": "git",
    "url": "https://github.com/oh-ashen-one/fairshare"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.525",
    "@remotion/tailwind-v4": "4.0.525",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.525",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts ResearchFlow ../dist/assets/research-flow.mp4 --codec=h264 --crf=25 --concurrency=2",
    "poster": "remotion still src/index.ts ResearchFlow ../dist/assets/research-flow.jpg --frame=143"
  },
  "sideEffects": [
    "*.css"
  ]
}
